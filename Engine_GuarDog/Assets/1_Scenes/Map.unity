  descriptionPanel: {fileID: 1190487490}
  upgradeText: {fileID: 1978668635}
  textMappings:
  - number: 1
    text: "\uCD5C\uB300\uCCB4\uB825 25 \uC0C1\uC2B9, \uACF5\uACA9\uB825 3 \uC0C1\uC2B9,\n\uCFE8\uD0C0\uC784
      0.05\uCD08 \uAC10\uC18C"
  - number: 2
    text: "\uAC8C\uC784\uC911 \uB2E8 \uD55C \uBC88 \uCCB4\uB825\uC774 0%\uC77C \uB54C
      \uCCB4\uB825\uC744 50 \uD68C\uBCF5\uD55C\uB2E4"
  - number: 3
    text: "20\uCD08\uB9C8\uB2E4 \uCCB4\uB825\uC744 10 \uD68C\uBCF5\uD55C\uB2E4\n\uCCB4\uB825\uC774
      99% \uC774\uD558\uC77C \uB54C \uACF5\uACA9\uB825\uC774 3 \uC99D\uAC00\uD55C\uB2E4"
  - number: 4
    text: "\uCCB4\uB825\uC774 100% \uC77C \uB54C \uACF5\uACA9\uB825\uC774 7 \uC99D\uAC00\uD558\uBA70\n\uCCB4\uB825\uC774
      99% \uC774\uD558\uC77C \uB54C \uACF5\uACA9\uB825\uC774 1 \uC99D\uAC00\uD55C\uB2E4"
  - number: 5
    text: "\uACF5\uACA9\uB825\uC774 1 \uAC10\uC18C\uD55C\uB2E4 \uD22C\uC0AC\uCCB4\uB97C
      \uBC1C\uC0AC \uC2DC\n\uC0AC\uC120\uC73C\uB85C \uD22C\uC0AC\uCCB4\uB97C 2\uBC1C
      \uCD94\uAC00 \uBC1C\uC0AC\uD55C\uB2E4"
  - number: 6
    text: "\uACF5\uACA9\uB825\uC774 1 \uAC10\uC18C\uD55C\uB2E4 \uD22C\uC0AC\uCCB4\uB97C
      \uBC1C\uC0AC \uC2DC\n\uD22C\uC0AC\uCCB4\uB97C 1\uD68C \uCD94\uAC00 \uBC1C\uC0AC\uD55C\uB2E4"
  - number: 7
    text: "\uD22C\uC0AC\uCCB4\uC758 \uD06C\uAE30\uAC00 \uC99D\uAC00\uD558\uACE0 \uD22C\uC0AC\uCCB4\uAC00
      \uAD00\uD1B5\uD55C\uB2E4"
  - number: 8
    text: "\uBAA8\uB4E0 \uCCB4\uB825\uC744 \uD68C\uBCF5\uD55C\uB2E4"
  - number: 9
    text: "\uACF5\uACA9\uB825\uC774 3 \uC99D\uAC00\uD55C\uB2E4"
  - number: 10
    text: "\uACF5\uACA9\uB825\uC774 5 \uC99D\uAC00\uD55C\uB2E4"
  - number: 11
    text: "\uCD5C\uB300\uCCB4\uB825\uC774 25 \uC99D\uAC00\uD558\uACE0 \uCCB4\uB825\uC744
      50 \uD68C\uBCF5\uD55C\uB2E4"
  - number: 12
    text: "\uCD5C\uB300\uCCB4\uB825\uC774 50 \uC99D\uAC00\uD558\uACE0 \uCCB4\uB825\uC744
      90 \uD68C\uBCF5\uD55C\uB2E4"
  - number: 13
    text: "\uC9D1\uC758 \uCCB4\uB825\uC744 100 \uD68C\uBCF5\uD55C\uB2E4"
  - number: 14
    text: "\uC9D1\uC758 \uCD5C\uB300\uCCB4\uB825\uC774 100 \uC99D\uAC00\uD55C\uB2E4"
